{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/WebitroHQ/promtexpress-oss/library/schema/template.schema.json",
  "title": "PromtExpress community prompt template",
  "description": "Editor autocompletion only. The source of truth is scripts/validate-library.mjs, which CI runs on every pull request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "description", "category", "modality", "language", "version", "authors", "variables", "template"],
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "description": "<modality>/<slug>, identical to the file path under library/templates",
      "pattern": "^(text|code|image|video|audio|music)/[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "description": { "type": "string", "minLength": 20, "maxLength": 300 },
    "category": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "examples": ["marketing", "ecommerce", "engineering", "productivity"] },
    "modality": { "enum": ["text", "code", "image", "video", "audio", "music"] },
    "engine": {
      "type": ["string", "null"],
      "description": "Destination AI the template is tuned for (e.g. \"midjourney\"), or null if it works everywhere"
    },
    "language": { "type": "string", "pattern": "^[a-z]{2}$", "description": "ISO 639-1 language of the template text" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 },
      "description": "GitHub usernames of everyone who wrote or substantially improved this template"
    },
    "tags": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" } },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "description", "required", "example"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "description": { "type": "string", "minLength": 3 },
          "required": { "type": "boolean" },
          "example": { "type": "string", "minLength": 1 }
        }
      }
    },
    "template": {
      "type": "string",
      "minLength": 40,
      "maxLength": 8000,
      "description": "Prompt text. Reference variables as {{name}}; every declared variable must be used."
    },
    "example": {
      "type": "object",
      "description": "Optional filled-in values showing the template in action",
      "additionalProperties": { "type": "string" }
    }
  }
}
