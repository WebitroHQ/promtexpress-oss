# Copy to .env.production (or .env.local for development) and fill in. Never commit the real file.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# --- Database and queue ---
# PostgreSQL 16 with the pgvector extension (the schema has a vector column, even though
# library search no longer needs an embedding model).
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/promtexpress
DIRECT_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/promtexpress
REDIS_URL=redis://127.0.0.1:6379
# "true" runs generations in the background worker (scripts/worker.entry.ts); needs Redis.
GENERATION_QUEUE_ENABLED=false
# GENERATION_WORKER_CONCURRENCY=8

# --- Secrets you must generate ---
# openssl rand -base64 32
AUTH_SECRET=
# openssl rand -hex 32  (64 hex characters; encrypts the AI provider keys users store)
AI_KEYS_ENCRYPTION_KEY=
# openssl rand -hex 32  (hashing pepper for PromtExpress API keys)
API_KEY_PEPPER=

# --- Admin panel (/pr/yonet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=
# bcrypt hash of the admin password
ADMIN_PASSWORD_HASH=

# --- Sign-in with Google (optional) ---
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Email (optional; verification and password-reset mail) ---
BREVO_SMTP_USER=
BREVO_SMTP_PASS=
EMAIL_FROM=PromtExpress <noreply@example.com>

# --- Bot protection on sign-up (optional) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Library search ---
# Default: Postgres full-text search, no external service. Set to "embedding" to use pgvector
# with an embedding engine configured in the admin panel.
# LIBRARY_SEARCH_MODE=embedding

# AI provider keys are NOT configured here. Each user adds their own key in Settings -> AI keys.
